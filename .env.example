# Application
APP_NAME=Library Catalog API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database (обязательно PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/library_catalog

# Database Pool
DATABASE_POOL_SIZE=20

# API
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc

# CORS
CORS_ORIGINS=["*"]

# External APIs
OPENLIBRARY_BASE_URL=https://openlibrary.org
OPENLIBRARY_TIMEOUT=10.0
